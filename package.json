{
  "name": "muhammad-cpp-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Muhammad C++ Studio \u2014 \u0645\u0646\u0635\u0629 \u062a\u0637\u0648\u064a\u0631 C++ \u0639\u0631\u0628\u064a\u0629 \u062a\u0639\u0645\u0644 \u0645\u0646 \u0627\u0644\u0645\u062a\u0635\u0641\u062d",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* --filter ./workers/linux-builder dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "build:web": "pnpm --filter @mcs/web build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "22.20.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^3.2.4",
    "ws": "8.23.0"
  }
}
